        <mxCell id="rbac" parent="1" style="swimlane;html=1;horizontal=1;startSize=28;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=20;fontStyle=1;" value="Role Capability Summary" vertex="1">
          <mxGeometry height="720" width="1160" x="1120" y="150" as="geometry" />
        </mxCell>
        <mxCell id="role1" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2;" value="&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;Register / validate&lt;br&gt;Route within authority&lt;br&gt;Monitor aging / returns&lt;br&gt;Cannot approve above delegated authority" vertex="1">
          <mxGeometry height="180" width="290" x="90" y="145" as="geometry" />
        </mxCell>
        <mxCell id="role2" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2;" value="&lt;b&gt;End User / Actionist&lt;/b&gt;&lt;br&gt;View assigned/FYI letters&lt;br&gt;Accept action&lt;br&gt;Work / comment / attach&lt;br&gt;Draft &amp;amp; submit response" vertex="1">
          <mxGeometry height="180" width="290" x="450" y="145" as="geometry" />
        </mxCell>
        <mxCell id="role3" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2;" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;Assign/delegate within dept/sub-units&lt;br&gt;Set due date / priority&lt;br&gt;Review &amp;amp; approve&lt;br&gt;Return for revision" vertex="1">
          <mxGeometry height="180" width="290" x="810" y="145" as="geometry" />
        </mxCell>
        <mxCell id="role4" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2;" value="&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;Top-tier review&lt;br&gt;Approve routing / response&lt;br&gt;Issue directions / actions&lt;br&gt;Approve external correspondence" vertex="1">
          <mxGeometry height="180" width="290" x="90" y="395" as="geometry" />
        </mxCell>
        <mxCell id="role5" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2;" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;Configure org/RBAC/templates/workflows&lt;br&gt;Manage users &amp;amp; system settings&lt;br&gt;&lt;i&gt;No implicit business-content access&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="290" x="450" y="395" as="geometry" />
        </mxCell>
        <mxCell id="role6" parent="rbac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=1.5;" value="&lt;b&gt;Viewer&lt;/b&gt;&lt;br&gt;Read-only within authorized scope&lt;br&gt;No routing / assignment / approval / edit" vertex="1">
          <mxGeometry height="180" width="290" x="810" y="395" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=21;strokeWidth=2;" value="&lt;b&gt;Authorization Rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALLOW = Role capability&lt;br&gt;AND Department scope&lt;br&gt;AND Letter/Action relationship&lt;br&gt;AND Workflow state&lt;br&gt;AND Delegation/exception policy" vertex="1">
          <mxGeometry height="250" width="470" x="170" y="900" as="geometry" />
        </mxCell>
        <mxCell id="auth2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=21;strokeWidth=1.5;" value="&lt;b&gt;Examples&lt;/b&gt;&lt;br&gt;• Manager can approve items belonging to own dept/sub-units.&lt;br&gt;• End user sees assigned actions and FYI letters explicitly addressed to them.&lt;br&gt;• Coordinator can route but not silently read unrelated departments.&lt;br&gt;• Cross-dept access must be an explicit grant with expiry and audit." vertex="1">
          <mxGeometry height="250" width="650" x="720" y="900" as="geometry" />
        </mxCell>
        <mxCell id="auth3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=21;strokeWidth=1.5;" value="&lt;b&gt;Security controls&lt;/b&gt;&lt;br&gt;Document-level ACL • department scope • version permissions • download/print controls • classification level • audit logging • least privilege • service account isolation for OCR/LLM." vertex="1">
          <mxGeometry height="250" width="700" x="1450" y="900" as="geometry" />
        </mxCell>
        <mxCell id="authnote" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;" value="&lt;b&gt;Recommended data rule&lt;/b&gt;&lt;br&gt;Persist department_id on RouteStep, ActionItem, ResponseApproval and UserScope. Do not infer authorization only from the letter’s current location." vertex="1">
          <mxGeometry height="130" width="1600" x="340" y="1220" as="geometry" />
        </mxCell>
      </root>
