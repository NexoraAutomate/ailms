POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ailms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# LLM (OpenAI-compatible: Ollama recommended locally; also OpenAI, Azure, LM Studio, optional vLLM)
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096

# OpenAI / cloud example:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional vLLM (Linux/WSL CUDA) — use port 8001+ so it does not clash with FastAPI 8000:
# LLM_PROVIDER=vllm
# LLM_API_KEY=EMPTY
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen3-8B
