POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ailms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI-assisted letter registration (staged upload → OCR → review → approve)
AI_REGISTRATION_ENABLED=true
# Worker drains QUEUED jobs (OCR/LLM). Leave false until pipeline steps are ready;
# jobs remain QUEUED and GET /jobs/{id} reports workerEnabled=false.
AI_REGISTRATION_WORKER_ENABLED=false
AI_REGISTRATION_WORKER_POLL_SECONDS=2

# OCR (local). Engine: auto | paddleocr | pymupdf_text
# auto uses paddleocr when installed; otherwise PDF text-layer via PyMuPDF.
OCR_ENGINE=auto
OCR_DPI=200
OCR_MAX_PAGES=50
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PADDLE_LANG=en

# LLM (OpenAI-compatible: Ollama recommended locally; also OpenAI, Azure, LM Studio, optional vLLM)
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
# Optional JSON object merged into chat/completions body (advanced; leave empty)
# LLM_EXTRA_BODY_JSON=
# When true, DEBUG logs may include document/user prompt text (default false)
AI_LOG_DOCUMENT_TEXT=false

# OpenAI / cloud example:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional vLLM (Linux/WSL CUDA) — use port 8001+ so it does not clash with FastAPI 8000:
# LLM_PROVIDER=vllm
# LLM_API_KEY=EMPTY
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen3-8B
