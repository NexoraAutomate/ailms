POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ailms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI-assisted letter registration background worker (drains QUEUED jobs)
AI_REGISTRATION_ENABLED=true
AI_REGISTRATION_WORKER_ENABLED=true
AI_REGISTRATION_WORKER_POLL_SECONDS=2

# OCR: auto prefers PaddleOCR when installed, else PyMuPDF text layer
OCR_ENGINE=auto
OCR_PADDLE_LANG=en

# ── LLM switch — change ONLY this to pick a backend ─────────────────────────
# Values: ollama | runpod | vllm | openai
LLM_PROVIDER=runpod

LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=900
LLM_MAX_TOKENS=4096
# auto = derive allowlist from LLM_PROVIDER; empty = no filter; or comma-separated hosts
LLM_ALLOWED_HOSTS=auto
# Optional JSON object merged into chat/completions body (advanced; leave empty)
# LLM_EXTRA_BODY_JSON=
# When true, DEBUG logs may include document/user prompt text (default false)
AI_LOG_DOCUMENT_TEXT=false

# ── Ollama (local) — used when LLM_PROVIDER=ollama ──────────────────────────
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_OLLAMA_API_KEY=ollama
LLM_OLLAMA_MODEL=qwen3:8b

# ── Runpod Serverless — used when LLM_PROVIDER=runpod ───────────────────────
LLM_RUNPOD_MODEL=Qwen/Qwen3-8B
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=br96s8zyygjs24
# Async is required for cold starts (Qwen3-8B can take several minutes to load).
RUNPOD_USE_ASYNC=true
RUNPOD_POLL_INTERVAL_SECONDS=2
RUNPOD_MAX_WAIT_SECONDS=900

# ── vLLM (local CUDA) — used when LLM_PROVIDER=vllm ─────────────────────────
# Bind vLLM to 8001+ so it does not clash with FastAPI on 8000.
LLM_VLLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_VLLM_API_KEY=EMPTY
LLM_VLLM_MODEL=Qwen/Qwen3-8B

# ── OpenAI — used when LLM_PROVIDER=openai ──────────────────────────────────
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
