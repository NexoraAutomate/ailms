POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ailms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI-assisted letter registration background worker (drains QUEUED jobs)
AI_REGISTRATION_ENABLED=true
AI_REGISTRATION_WORKER_ENABLED=true
AI_REGISTRATION_WORKER_POLL_SECONDS=2

# OCR: auto prefers PaddleOCR when installed, else PyMuPDF text layer
OCR_ENGINE=auto
OCR_PADDLE_LANG=en

# LLM — Runpod profile active (flip LLM_PROVIDER=ollama + loopback allowlist for local)
LLM_ENABLED=true
LLM_PROVIDER=runpod
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=900
LLM_MAX_TOKENS=4096
LLM_ALLOWED_HOSTS=api.runpod.ai
# Optional JSON object merged into chat/completions body (advanced; leave empty)
# LLM_EXTRA_BODY_JSON=
# When true, DEBUG logs may include document/user prompt text (default false)
AI_LOG_DOCUMENT_TEXT=false

# Runpod Serverless (queue-based vLLM)
RUNPOD_API_KEY=rpa_XYZI5LECCJI6TVKIPLG5XJ91QUFE1OMLTX5IO0IQF1lvne
RUNPOD_ENDPOINT_ID=br96s8zyygjs24
# Async is required for cold starts (Qwen3-8B can take several minutes to load).
RUNPOD_USE_ASYNC=true
RUNPOD_POLL_INTERVAL_SECONDS=2
RUNPOD_MAX_WAIT_SECONDS=900

# OpenAI / cloud example:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional vLLM (Linux/WSL CUDA) — use port 8001+ so it does not clash with FastAPI 8000:
# LLM_PROVIDER=vllm
# LLM_API_KEY=EMPTY
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen3-8B
