<mxfile host="app.diagrams.net" agent="AILMS" version="22.1.0" type="device">
  <diagram id="org-hierarchy" name="1. Organization Hierarchy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AILMS — Organization Hierarchy (Parent / Child)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Parents can mark letters back to children until a satisfactory response is received" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#744210;" vertex="1" parent="1">
          <mxGeometry x="200" y="52" width="680" height="24" as="geometry" />
        </mxCell>

        <!-- Level 0: Tech Coord -->
        <mxCell id="tech" value="&lt;b&gt;Tech Coord&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SUPER PARENT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Receives external letters • Routes to Chairman • Final dispatch gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#ffffff;strokeColor=#0d2137;align=center;verticalAlign=middle;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- Chairman (approval authority, sibling to hierarchy for clarity) -->
        <mxCell id="chairman" value="&lt;b&gt;Chairman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Approval Authority&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c53030;fontColor=#ffffff;strokeColor=#9b2c2c;align=center;verticalAlign=middle;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="115" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-tech-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#c53030;fontSize=10;fontColor=#c53030;" edge="1" parent="1" source="tech" target="chairman">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e-tech-ch-lbl" value="seeks approval" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#c53030;" vertex="1" connectable="0" parent="e-tech-ch">
            <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2b6cb0;strokeWidth=2;" edge="1" parent="1" source="tech" target="coord">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 1: Coordination Office -->
        <mxCell id="coord" value="&lt;b&gt;Coordination Office&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GRANDPARENT (child of Tech Coord)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Evaluates letter type • Prepares response OR forwards • Secures HoD approval before return to Tech Coord&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;fontColor=#ffffff;strokeColor=#1a4a7a;align=center;verticalAlign=middle;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2b6cb0;strokeWidth=2;" edge="1" parent="1" source="coord" target="proj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2b6cb0;strokeWidth=2;" edge="1" parent="1" source="coord" target="other">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 2: Project / Other offices -->
        <mxCell id="proj" value="&lt;b&gt;Project Office&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PARENT (child of Coord)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;May prepare response or forward down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;fontColor=#ffffff;strokeColor=#2b6cb0;align=center;verticalAlign=middle;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="390" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="other" value="&lt;b&gt;Other Technical / User Office&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PARENT (child of Coord)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;May prepare response or forward down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;fontColor=#ffffff;strokeColor=#2b6cb0;align=center;verticalAlign=middle;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="390" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2b6cb0;strokeWidth=2;" edge="1" parent="1" source="proj" target="dept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2b6cb0;strokeWidth=2;" edge="1" parent="1" source="other" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Level 3: End users -->
        <mxCell id="dept" value="&lt;b&gt;X Department / End User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CHILD&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prepares response and shares upward to parent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#63b3ed;fontColor=#1a365d;strokeColor=#2b6cb0;align=center;verticalAlign=middle;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="530" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;X Department / End User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CHILD&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prepares response and shares upward to parent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#63b3ed;fontColor=#1a365d;strokeColor=#2b6cb0;align=center;verticalAlign=middle;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Mark-back note -->
        <mxCell id="markback" value="&lt;b&gt;Mark-back rule&lt;/b&gt;&lt;br&gt;Any parent can return a letter to its child&lt;br&gt;until a satisfactory response is received.&lt;br&gt;(Applies at every level of the hierarchy.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;fontColor=#744210;strokeColor=#d69e2e;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg" value="&lt;b&gt;Hierarchy chain&lt;/b&gt;&lt;br&gt;Tech Coord → Coordination Office → Project / Other Office → Dept / End User&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c53030&quot;&gt;■ Chairman&lt;/font&gt; = approval authority (not a hierarchy parent)&lt;br&gt;&lt;font color=&quot;#2b6cb0&quot;&gt;■ Blue levels&lt;/font&gt; = operational parents / children" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;fontColor=#2d3748;strokeColor=#a0aec0;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="640" width="520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="letter-received" name="2. Letter Received">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="Workflow 1 — Letter Received (Inbound from outside organization)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="720" height="30" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="ext" value="External sender&lt;br&gt;(outside organization)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#718096;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="&lt;b&gt;1. Tech Coord&lt;/b&gt;&lt;br&gt;Receives letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#fff;strokeColor=#0d2137;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r2" value="&lt;b&gt;2. Chairman&lt;/b&gt;&lt;br&gt;Approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c53030;fontColor=#fff;strokeColor=#9b2c2c;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r3" value="&lt;b&gt;3. Tech Coord&lt;/b&gt;&lt;br&gt;Forward for action to&lt;br&gt;Coordination Office&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(info copy to relevant depts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#fff;strokeColor=#0d2137;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e-ext-r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="ext" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r1-r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r2-r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Coordination evaluation -->
        <mxCell id="r4" value="&lt;b&gt;4. Coordination Office&lt;/b&gt;&lt;br&gt;Evaluate letter type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;fontColor=#fff;strokeColor=#1a4a7a;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-r3-r4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="d1" value="Can Coord&lt;br&gt;prepare response?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;fontSize=11;fontColor=#7b341e;" vertex="1" parent="1">
          <mxGeometry x="665" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e-r4-d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r4" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- YES path - Coord prepares -->
        <mxCell id="r5a" value="&lt;b&gt;5a. Coordination Office&lt;/b&gt;&lt;br&gt;Prepare response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;fontColor=#fff;strokeColor=#1a4a7a;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-d1-r5a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#38a169;strokeWidth=2;fontSize=10;fontColor=#276749;" edge="1" parent="1" source="d1" target="r5a">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="lbl-yes1" value="YES" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#276749;fontStyle=1" vertex="1" connectable="0" parent="e-d1-r5a">
            <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>

        <!-- NO path - forward down hierarchy -->
        <mxCell id="r5b" value="&lt;b&gt;5b. Forward to&lt;/b&gt;&lt;br&gt;Project / Technical Office&lt;br&gt;or User (under hierarchy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;fontColor=#fff;strokeColor=#2b6cb0;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="320" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-d1-r5b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#e53e3e;strokeWidth=2;" edge="1" parent="1" source="d1" target="r5b">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="lbl-no1" value="NO" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#c53030;fontStyle=1" vertex="1" connectable="0" parent="e-d1-r5b">
            <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>

        <!-- Recursive hierarchy loop -->
        <mxCell id="d2" value="Can this level&lt;br&gt;prepare response?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;fontSize=11;fontColor=#7b341e;" vertex="1" parent="1">
          <mxGeometry x="910" y="440" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e-r5b-d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r5b" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r6" value="&lt;b&gt;6. Child / End User&lt;/b&gt;&lt;br&gt;Prepare response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#63b3ed;fontColor=#1a365d;strokeColor=#2b6cb0;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="450" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-d2-r6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#38a169;strokeWidth=2;" edge="1" parent="1" source="d2" target="r6">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="lbl-yes2" value="YES" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#276749;fontStyle=1" vertex="1" connectable="0" parent="e-d2-r6">
            <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>

        <mxCell id="r5c" value="&lt;b&gt;Forward further down&lt;/b&gt;&lt;br&gt;(to next child under hierarchy)&lt;br&gt;Loop continues…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90cdf4;fontColor=#1a365d;strokeColor=#2b6cb0;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="580" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-d2-r5c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#e53e3e;strokeWidth=2;" edge="1" parent="1" source="d2" target="r5c">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="lbl-no2" value="NO" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#c53030;fontStyle=1" vertex="1" connectable="0" parent="e-d2-r5c">
            <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>
        <!-- loop back visual -->
        <mxCell id="e-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#718096;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5c" target="d2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="615" />
              <mxPoint x="860" y="530" />
            </Array>
          </mxGeometry>
          <mxCell id="lbl-loop" value="repeat until response ready" style="edgeLabel;html=1;align=center;fontSize=9;fontColor=#4a5568;" vertex="1" connectable="0" parent="e-loop">
            <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="10" as="offset" /></mxGeometry>
          </mxCell>
        </mxCell>

        <!-- Share upward -->
        <mxCell id="r7" value="&lt;b&gt;7. Share response upward&lt;/b&gt;&lt;br&gt;Child → Parent → … → Coordination Office&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Parent may MARK BACK to child if unsatisfactory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#805ad5;fontColor=#fff;strokeColor=#553c9a;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-r6-r7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#805ad5;strokeWidth=2;" edge="1" parent="1" source="r6" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r5a-r7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#805ad5;strokeWidth=2;" edge="1" parent="1" source="r5a" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Mark back -->
        <mxCell id="mb" value="MARK BACK&lt;br&gt;(unsatisfactory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;fontColor=#744210;strokeColor=#d69e2e;fontSize=10;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-r7-mb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d69e2e;strokeWidth=1;dashed=1;" edge="1" parent="1" source="r7" target="mb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-mb-r6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#d69e2e;strokeWidth=1;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mb" target="r6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="560" />
              <mxPoint x="1225" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Coord has response - HoD approval -->
        <mxCell id="r8" value="&lt;b&gt;8. Coordination Office&lt;/b&gt;&lt;br&gt;Secure approval of&lt;br&gt;respective Head of Department / Member" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;fontColor=#fff;strokeColor=#1a4a7a;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="570" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-r7-r8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r7" target="r8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r9" value="&lt;b&gt;9. Share with Tech Coord&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#fff;strokeColor=#0d2137;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="690" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-r8-r9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r8" target="r9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r10" value="&lt;b&gt;10. Chairman Approval&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c53030;fontColor=#fff;strokeColor=#9b2c2c;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="780" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-r9-r10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="r9" target="r10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r11" value="&lt;b&gt;11. DISPATCH&lt;/b&gt;&lt;br&gt;Letter sent to addressee(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#276749;fontColor=#fff;strokeColor=#22543d;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="870" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-r10-r11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#276749;strokeWidth=2;" edge="1" parent="1" source="r10" target="r11"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Notes box -->
        <mxCell id="note2" value="&lt;b&gt;Key rules&lt;/b&gt;&lt;br&gt;• Info copies may go to relevant departments at step 3&lt;br&gt;• Hierarchy: Tech Coord → Coord → Project/Office → Dept/User&lt;br&gt;• Any parent can mark back to child until satisfied&lt;br&gt;• Response must climb back to Coord before HoD + Chairman path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;fontColor=#2d3748;strokeColor=#a0aec0;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="340" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="letter-dispatched" name="3. Letter Dispatched Only">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="Workflow 2 — Letter Dispatched Only (Outbound, originated inside)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t3s" value="Any department drafts a letter → approval chain → dispatch outside organization" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#4a5568;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="720" height="24" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;1. Any Department / User&lt;/b&gt;&lt;br&gt;Drafts / writes letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#63b3ed;fontColor=#1a365d;strokeColor=#2b6cb0;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;b&gt;2. Share to concerned&lt;/b&gt;&lt;br&gt;&lt;b&gt;Coordination Office&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;fontColor=#fff;strokeColor=#1a4a7a;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;b&gt;3. Secure approval of&lt;/b&gt;&lt;br&gt;Member / Head of Department" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dd6b20;fontColor=#fff;strokeColor=#c05621;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="&lt;b&gt;4. Share with Tech Coord&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#fff;strokeColor=#0d2137;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d5" value="&lt;b&gt;5. Chairman Approval&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c53030;fontColor=#fff;strokeColor=#9b2c2c;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d6" value="&lt;b&gt;6. DISPATCH OUTSIDE&lt;/b&gt;&lt;br&gt;Organization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#276749;fontColor=#fff;strokeColor=#22543d;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;strokeWidth=2;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#276749;strokeWidth=2;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Side notes -->
        <mxCell id="n1" value="&lt;b&gt;Origin&lt;/b&gt;&lt;br&gt;Letter is written inside&lt;br&gt;the organization&lt;br&gt;(any dept under hierarchy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;fontColor=#2a4365;strokeColor=#63b3ed;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Approval chain&lt;/b&gt;&lt;br&gt;Coord → Member/HoD&lt;br&gt;→ Tech Coord → Chairman&lt;br&gt;→ Dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;fontColor=#742a2a;strokeColor=#fc8181;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Mark-back&lt;/b&gt;&lt;br&gt;Tech Coord / Chairman / HoD&lt;br&gt;may return for revision&lt;br&gt;before dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;fontColor=#744210;strokeColor=#d69e2e;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="430" width="220" height="90" as="geometry" />
        </mxCell>

