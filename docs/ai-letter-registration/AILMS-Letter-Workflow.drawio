        <mxCell id="cmp" value="&lt;b&gt;vs Letter Received&lt;/b&gt;&lt;br&gt;No inbound intake or downward action chain.&lt;br&gt;Starts at drafting dept and goes straight up the approval ladder for external dispatch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;fontColor=#2d3748;strokeColor=#a0aec0;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="730" width="500" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

